rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Somente o próprio usuário do Google pode ler/gravar seu QUADRA.
    match /users/{userId}/quadra/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && docId.matches('^(games-[0-9]{4}-[0-9]{2}|games-outros|preferences|extras|custom)$')
        && request.resource.data.keys().hasOnly(['notes', 'settings', 'extras', 'custom', 'version', 'updatedAt']);
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
